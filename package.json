{
  "name": "rigs-unbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && npm --prefix experiments/deterministic-kernel-probe run typecheck",
    "test": "vitest run && npm run test:kernel-probe",
    "test:browser": "node tools/rig-lab-browser-acceptance.cjs",
    "test:kernel-probe": "npm --prefix experiments/deterministic-kernel-probe test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json tsconfig.json vite.config.ts vitest.config.ts index.html \"src/**/*.{ts,css}\" \"tools/**/*.cjs\""
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  }
}
