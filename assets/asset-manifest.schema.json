{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigs-unbound.invalid/schemas/asset-manifest-v1.json",
  "title": "Rigs Unbound Asset Manifest",
  "type": "object",
  "required": ["schemaVersion", "assetRoot", "runtimeFormat", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetRoot": { "type": "string", "minLength": 1 },
    "runtimeFormat": { "const": "glb" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status",
        "sourceType",
        "rightsStatus",
        "intendedUse",
        "publicRuntimeApproved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "concept",
            "proposed",
            "procedural-candidate",
            "approved",
            "runtime-tested",
            "blocked"
          ]
        },
        "sourceType": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "specPath": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "runtimePath": { "type": ["string", "null"] },
        "runtimePresentation": {
          "type": "object",
          "required": [
            "siteId",
            "offsetX",
            "offsetZ",
            "yaw",
            "targetMaxDimension",
            "fallbackWidth",
            "fallbackHeight",
            "fallbackDepth",
            "fallbackColor"
          ],
          "properties": {
            "siteId": { "type": "string", "minLength": 1 },
            "offsetX": { "type": "number" },
            "offsetZ": { "type": "number" },
            "yaw": { "type": "number" },
            "targetMaxDimension": { "type": "number", "exclusiveMinimum": 0 },
            "fallbackWidth": { "type": "number", "exclusiveMinimum": 0 },
            "fallbackHeight": { "type": "number", "exclusiveMinimum": 0 },
            "fallbackDepth": { "type": "number", "exclusiveMinimum": 0 },
            "fallbackColor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            }
          },
          "additionalProperties": false
        },
        "licensePath": { "type": "string", "minLength": 1 },
        "licenseSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicRuntimeApproved": { "type": "boolean" },
        "sourceFormInPlayerBuild": {
          "type": "boolean",
          "description": "True when this asset's SOURCE form (sourcePath) is deliberately compiled into the player bundle, independently of whether its runtime binary (runtimePath) is approved to ship. Only meaningful for sourceType values that are compiled modules, e.g. authored-procedural-factory. Absent means false. This never relaxes byte containment: an unapproved runtimePath must still be absent from the build regardless of this flag."
        },
        "rightsStatus": { "type": "string", "minLength": 1 },
        "intendedUse": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
